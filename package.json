{
  "name": "@bindist/client",
  "version": "1.0.2",
  "description": "TypeScript/JavaScript client for the BinDist API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "build:browser": "tsup src/browser.ts --format iife --minify --outDir dist/browser",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build"
  },
  "keywords": [
    "bindist",
    "api-client",
    "distribution",
    "application"
  ],
  "author": "BinDist <dev@bindist.eu>",
  "homepage": "https://docs.bindist.eu/sdks/javascript.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BinDist/bindist-api-javascript.git"
  },
  "bugs": {
    "url": "https://github.com/BinDist/bindist-api-javascript/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
